# Local development only. Copy to .env; never commit real credentials.
DATABASE_URL=postgres://poa:poa-local-only@localhost:54329/poa
API_PORT=3001
# Next.js host default is http://localhost:3001; Compose supplies http://api:3001.
API_INTERNAL_URL=http://localhost:3001
NEXT_TELEMETRY_DISABLED=1
# Local-only M3/M4 experiment fixture. Leave disabled for normal service startup.
POA_ENABLE_SYNTHETIC_M3=0
# These remain in the self-hosted agent process, never API/worker configuration:
POA_API_URL=http://localhost:3001
POA_AGENT_PRIVATE_KEY=
# Disabled external integrations; setting these alone never enables a profile.
ETHEREUM_MAINNET_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=
ARC_TESTNET_RPC_URL=
ARC_MAINNET_RPC_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only operator testnet publication/relayer keys belong in later service secrets.
# The agent decision key remains on the agent's own infrastructure.
