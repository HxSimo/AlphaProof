# Local development only. Copy to .env; never commit real credentials.
DATABASE_URL=postgres://poa:poa-local-only@localhost:54329/poa
API_PORT=3001
# Next.js host default is http://localhost:3001; Compose supplies http://api:3001.
API_INTERNAL_URL=http://localhost:3001
NEXT_TELEMETRY_DISABLED=1
# Local-only M3/M4 experiment fixture. Leave disabled for normal service startup.
POA_ENABLE_SYNTHETIC_M3=0
# These remain in the self-hosted agent process, never API/worker configuration:
POA_API_URL=http://localhost:3001
POA_AGENT_PRIVATE_KEY=
# Disabled external integrations; setting these alone never enables a profile.
ETHEREUM_MAINNET_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=
ARC_TESTNET_RPC_URL=
ARC_MAINNET_RPC_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# M5 live testnet gate. This spends faucet tokens and deploys test-only vaults.
POA_RUN_LIVE_TESTNET=0
POA_TESTNET_DEPLOYER_PRIVATE_KEY=
POA_TESTNET_RELAYER_PRIVATE_KEY=
POA_LIVE_EVIDENCE_DIR=.local-evidence/m5
POA_LIVE_OUTBOUND_TRANSFER_AMOUNT_MINOR=20000000
POA_LIVE_RETURN_TRANSFER_AMOUNT_MINOR=10000000
POA_LIVE_VAULT_DEPOSIT_MINOR=1000000
POA_LIVE_YIELD_BUDGET_MINOR=100000
POA_TESTNET_EXPERIMENT_START_EPOCH=
# M6 Arc Testnet registry gate. Owner and publisher must be distinct. The M5
# disposable deployer/relayer keys are fallback inputs for the retained demo.
POA_RUN_LIVE_M6=0
POA_REGISTRY_OWNER_PRIVATE_KEY=
POA_REGISTRY_PUBLISHER_PRIVATE_KEY=
POA_M6_EVIDENCE_DIR=.local-evidence/m6
POA_M6_RESUME_DEPLOYMENT_HASH=
POA_M6_RESUME_PUBLICATION_HASH=
POA_RUN_LIVE_M6_CORRECTION=0
POA_M6_CORRECTION_TX_HASH=
POA_RUN_LIVE_M6_VERIFY=0
# Read-only dashboard selector; the experiment must already have canonical M4/M6 rows.
POA_DEMO_EXPERIMENT_ID=
# Only operator testnet publication/relayer keys belong in service secrets.
# The agent decision key remains on the agent's own infrastructure.
# M7 control API authentication (random secret >=32 characters; server + operator only).
POA_OPERATOR_TOKEN=
# Kept empty for the default database; demo:configure writes a separate local selector.
POA_DATABASE_OPTIONS=
# Independent explicit gates; neither changes manifest activation.
POA_RUN_LIVE_M7_PUBLICATION=0
POA_RUN_LIVE_M7_VERIFY=0
POA_REQUIRE_FRESH_FORWARD=0
