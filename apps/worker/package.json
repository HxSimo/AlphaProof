{
  "name": "@poa/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@poa/config": "workspace:*",
    "@poa/domain": "workspace:*",
    "@poa/experiments": "workspace:*",
    "@poa/schemas": "workspace:*",
    "@poa/storage": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.13"
  }
}
