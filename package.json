{
  "name": "proof-of-alpha",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.21.1 <23"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:db": "node --env-file-if-exists=.env --import tsx tests/database/foundation.ts && node --env-file-if-exists=.env --import tsx tests/database/m3.ts && node --env-file-if-exists=.env --import tsx tests/database/m4.ts && node --env-file-if-exists=.env --import tsx tests/database/m5.ts && node --env-file-if-exists=.env --import tsx tests/database/m6.ts",
    "test:replay": "node --import tsx tests/replay/m2.ts && node --import tsx tests/replay/m4.ts && node --import tsx tests/replay/m5.ts && node --import tsx tests/replay/m6.ts",
    "test:e2e:signed-intent": "node --env-file-if-exists=.env --import tsx tests/end-to-end/signed-intent.ts",
    "test:e2e:scenarios": "node --env-file-if-exists=.env --import tsx tests/end-to-end/scenarios.ts",
    "test:e2e:export-proof": "node --env-file-if-exists=.env --import tsx tests/end-to-end/export-proof.ts",
    "test:fork": "node --import tsx tests/fork/m2-gate.ts",
    "test:live:testnet": "node --env-file-if-exists=.env --import tsx tests/live/m5-testnet.ts",
    "test:evidence:m5": "node --env-file-if-exists=.env --import tsx scripts/verify-m5-live-evidence.ts",
    "capture:evidence:m5": "node --env-file-if-exists=.env --import tsx scripts/capture-m5-archive-evidence.ts",
    "publish:registry:m6": "node --env-file-if-exists=.env --import tsx scripts/publish-m6-registry.ts",
    "publish:correction:m6": "node --env-file-if-exists=.env --import tsx scripts/publish-m6-correction.ts",
    "test:evidence:m6": "node --env-file-if-exists=.env --import tsx scripts/verify-m6-evidence.ts",
    "config:promote:m6": "node --import tsx scripts/promote-m6-registry.ts",
    "config:promote:m5": "node --import tsx scripts/promote-m5-testnet.ts",
    "replay:m2": "node --import tsx scripts/replay-m2.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "config:validate": "node --env-file-if-exists=.env --import tsx scripts/config.ts check",
    "config:seal": "node --env-file-if-exists=.env --import tsx scripts/config.ts seal",
    "schemas:generate": "node --env-file-if-exists=.env --import tsx scripts/schemas.ts write",
    "schemas:check": "node --env-file-if-exists=.env --import tsx scripts/schemas.ts check",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "worker:once": "node --env-file-if-exists=.env --import tsx apps/worker/src/main.ts --once",
    "plan": "node --env-file-if-exists=.env --import tsx scripts/plan.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm config:validate && pnpm schemas:check && pnpm plan:check && pnpm test && pnpm build",
    "smoke": "node --env-file-if-exists=.env --import tsx tests/smoke.ts",
    "plan:check": "node --import tsx scripts/plan.ts --check"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.13",
    "vitest": "4.1.11",
    "prettier": "3.9.6",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@poa/domain": "workspace:*",
    "@poa/schemas": "workspace:*",
    "@poa/config": "workspace:*",
    "@poa/accounting": "workspace:*",
    "@poa/storage": "workspace:*",
    "@poa/market-data": "workspace:*",
    "@poa/adapters": "workspace:*",
    "@poa/experiments": "workspace:*",
    "@poa/execution": "workspace:*",
    "@poa/sdk": "workspace:*",
    "@poa/valuation": "workspace:*",
    "@poa/evaluation": "workspace:*",
    "@poa/transfers": "workspace:*",
    "@poa/commitments": "workspace:*",
    "viem": "2.56.3"
  }
}
