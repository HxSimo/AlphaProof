{
  "name": "proof-of-alpha",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.21.1 <23"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:db": "node --env-file-if-exists=.env --import tsx tests/database/foundation.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "config:validate": "node --env-file-if-exists=.env --import tsx scripts/config.ts check",
    "config:seal": "node --env-file-if-exists=.env --import tsx scripts/config.ts seal",
    "schemas:generate": "node --env-file-if-exists=.env --import tsx scripts/schemas.ts write",
    "schemas:check": "node --env-file-if-exists=.env --import tsx scripts/schemas.ts check",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "worker:once": "node --env-file-if-exists=.env --import tsx apps/worker/src/main.ts --once",
    "plan": "node --env-file-if-exists=.env --import tsx scripts/plan.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm config:validate && pnpm schemas:check && pnpm plan:check && pnpm test && pnpm build",
    "smoke": "node --env-file-if-exists=.env --import tsx tests/smoke.ts",
    "plan:check": "node --import tsx scripts/plan.ts --check"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.13",
    "vitest": "4.1.11",
    "prettier": "3.9.6",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@poa/domain": "workspace:*",
    "@poa/schemas": "workspace:*",
    "@poa/config": "workspace:*",
    "@poa/accounting": "workspace:*",
    "@poa/storage": "workspace:*"
  }
}
